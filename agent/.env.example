ROUTERAI_API_KEY=your-key-here
BASE_URL=https://routerai.ru/api/v1
MODEL=deepseek/deepseek-v4-flash

# Системный промпт — первое сообщение в истории чата (role: system).
# SYSTEM_PROMPT=Ты — ассистент проекта Computer Monitoring System. Отвечай кратко.

# Максимум шагов агентного цикла (запрос + вызовы инструментов).
# MAX_STEPS=8

# Печатать точные сообщения инструментов, которые уходят модели
# (удобно, чтобы показать в отчёте, что модель получает при отказе).
# AGENT_DEBUG=1
